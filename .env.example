# HEDIS CareGap Environment Configuration Template
# Copy this to .env.local and fill in your actual values
# DO NOT commit .env.local to git (it's in .gitignore)

# ============================================================================
# Firebase Configuration
# Get these values from: Firebase Console > Project Settings > Your Apps > Web
# ============================================================================

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ============================================================================
# Claude API Configuration (for note generation)
# Get from: https://console.anthropic.com/api_keys
# ============================================================================

VITE_CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE
VITE_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# Application Configuration
# ============================================================================

VITE_ENV=development
VITE_APP_NAME=HEDIS CareGap
VITE_APP_VERSION=1.0.0
VITE_DEBUG=true

# ============================================================================
# Database Configuration (optional, for backend services)
# ============================================================================

DATABASE_URL=postgresql://user:password@localhost:5432/caregap
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_USER=caregap
POSTGRES_DB=caregap

# ============================================================================
# Redis Configuration (optional, for caching)
# ============================================================================

REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# Sentry Configuration (optional, for error tracking)
# ============================================================================

VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=development

# ============================================================================
# Monitoring & Analytics
# ============================================================================

VITE_ENABLE_ANALYTICS=true
VITE_LOG_LEVEL=info

# ============================================================================
# Docker Configuration
# ============================================================================

DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_username
DOCKER_PASSWORD=your_password

# ============================================================================
# Server Configuration
# ============================================================================

PORT=3000
NODE_ENV=development
HOST=localhost

# ============================================================================
# Feature Flags
# ============================================================================

VITE_ENABLE_VOICE_RECORDING=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_CLOUD_BACKUP=true
VITE_ENABLE_ENCRYPTION=true

# ============================================================================
# Security Configuration
# ============================================================================

# Encryption key (optional - auto-derived from user ID if not set)
VITE_ENCRYPTION_KEY_DERIVATION=true

# HIPAA Compliance Features
VITE_HIPAA_MODE=true
VITE_AUDIT_LOGGING=true
VITE_DATA_RETENTION_DAYS=2555  # 7 years

# ============================================================================
# Mobile Configuration
# ============================================================================

VITE_CAPACITOR_APP_ID=com.hedis.caregap
VITE_CAPACITOR_APP_NAME=HEDIS CareGap

# ============================================================================
# Instructions
# ============================================================================
#
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in all values (at minimum, Firebase config)
#
# 3. For development:
#    - Use test Firebase project
#    - Use dummy API keys where not needed
#
# 4. For production:
#    - Use production Firebase project
#    - Ensure all keys are valid and scoped properly
#    - Use strong passwords for databases
#    - Enable HIPAA mode for healthcare deployments
#
# 5. Never commit .env.local to version control!
#    It's automatically ignored by .gitignore
#
# ============================================================================
